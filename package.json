{
  "name": "ui-automation-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript UI framework with a self-hosted app, governed self-healing and layered reporting.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "sut": "tsx sut-ui/server.ts",
    "test": "playwright test --project=chromium --project=mobile --project=visual --project=a11y",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:live": "playwright test --project=live --workers=1",
    "test:demo": "playwright test --project=demo",
    "tools:test": "vitest run --config tools/vitest.config.mts",
    "qa": "tsx tools/src/cli.ts"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "allure-commandline": "2.46.1",
    "allure-js-commons": "3.14.0",
    "allure-playwright": "3.14.0",
    "eslint": "10.13.0",
    "eslint-plugin-playwright": "2.12.1",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
